{
  "tests": [
    {
      "name": "Отказ без авторизации владельца",
      "method": "GET",
      "path": "/?action=ping",
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Создание документа без токена запрещено",
      "method": "POST",
      "path": "/?action=create_doc",
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Поиск на сайте без токена запрещён",
      "method": "POST",
      "path": "/?action=site_lookup",
      "body": {
        "site": "weissgauff",
        "article": "441835"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "nomen_search без токена запрещён",
      "method": "POST",
      "path": "/?action=nomen_search",
      "body": {
        "query": "кастрюл набор"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "nomen_group_create без токена запрещён",
      "method": "POST",
      "path": "/?action=nomen_group_create",
      "body": {
        "name": "Тест",
        "parent": ""
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}