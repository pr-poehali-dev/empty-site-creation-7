{
  "tests": [
    {
      "name": "Служба отвечает",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"status": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Список поставщиков приёмки",
      "method": "GET",
      "path": "/?action=suppliers",
      "expectedStatus": 200
    },
    {
      "name": "Журнал загрузок",
      "method": "GET",
      "path": "/?action=uploads",
      "expectedStatus": 200
    },
    {
      "name": "Подмена телефона не даёт загружать",
      "method": "POST",
      "path": "/",
      "headers": {"X-User-Phone": "+79606488639"},
      "body": {"action": "create_supplier", "name": "Тест"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Загрузка без прав закрыта",
      "method": "POST",
      "path": "/",
      "body": {"action": "start_upload", "supplier_id": 1, "file_name": "test.xlsx"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Удаление загрузки без прав закрыто",
      "method": "POST",
      "path": "/",
      "body": {"action": "drop_upload", "upload_id": 999999},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Проверка штрихкодов работает",
      "method": "POST",
      "path": "/",
      "body": {"action": "check_barcodes", "barcodes": ["NOPE-0001"]},
      "expectedStatus": 200,
      "expectedBody": {"known": 0},
      "bodyMatcher": "partial"
    }
  ]
}