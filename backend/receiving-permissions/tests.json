{
  "tests": [
    {
      "name": "Служба отвечает",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"status": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Без токена входа всё закрыто",
      "method": "GET",
      "path": "/?action=my",
      "expectedStatus": 200,
      "expectedBody": {"is_owner": false, "authorized": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Поддельный токен не проходит",
      "method": "GET",
      "path": "/?action=my",
      "headers": {"X-Authorization": "Bearer ffffffffffffffffffffffffffffffff"},
      "expectedStatus": 200,
      "expectedBody": {"is_owner": false, "authorized": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Подмена телефона не даёт прав",
      "method": "GET",
      "path": "/?action=matrix",
      "headers": {"X-User-Phone": "+79606488639"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Переключение права без токена закрыто",
      "method": "POST",
      "path": "/",
      "body": {"action": "set_perm", "role_id": 4, "perm_key": "wh_sgp", "enabled": true},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Неизвестное действие отклоняется",
      "method": "POST",
      "path": "/",
      "body": {"action": "nope"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}